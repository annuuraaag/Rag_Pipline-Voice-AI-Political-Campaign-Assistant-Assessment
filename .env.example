# Copy to .env and fill in. Every value has a working default except the LLM key.

# ── LLM ────────────────────────────────────────────────────────────────
# groq | openai | ollama | extractive  (extractive = offline fallback, no LLM)
LLM_PROVIDER=groq
# If this model is retired, the app switches to an available one automatically (see logs).
# Current Groq models: https://console.groq.com/docs/models
LLM_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=
# OPENAI_API_KEY=
# LLM_BASE_URL=http://host.docker.internal:11434/v1   # e.g. for Ollama
LLM_TIMEOUT_S=20
LLM_MAX_TOKENS=300

# ── Retrieval ──────────────────────────────────────────────────────────
TOP_K=4
CANDIDATE_K=20
SIMILARITY_THRESHOLD=0.62      # gate without reranker (best dense cosine)
RETRIEVAL_MODE=hybrid          # hybrid | dense | bm25
MAX_CHUNKS_PER_DOC=2           # multi-document diversity in the LLM context

# ── Reranking (cross-encoder; downloaded at Docker build, optional) ─────
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2   # empty → disabled
RERANK_K=12
RERANK_THRESHOLD=0.15          # measured: negatives ≤0.0008, positives well above (eval/results/rerank_docker_run.md)

# ── Conversation ─────────────────────────────────────────────────────
QUERY_REWRITER=rules           # rules | llm (rules + LLM refinement with a 1.2 s timeout)
SESSION_TTL_S=1800

# ── Voice (WS /ws/voice; see docs/API.md) ──────────────────────────────
VOICE_DEBOUNCE_MS=250          # S1: wait after a triggering partial transcript before searching
VOICE_STABLE_MS=500            # S2: rerank ahead of time once the transcript is stable this long
VOICE_MIN_WORDS=3              # S0: shorter partials are ignored
VOICE_WORD_STEP=3              # S1: search again after this many new words
# End of turn: the silence that ends a question depends on how finished it sounds.
VOICE_ADAPTIVE_ENDPOINTING=true
VOICE_ENDPOINT_COMPLETE_MS=300     # "... for chilli farmers in Guntur"
VOICE_ENDPOINT_LIKELY_MS=550       # "... will be filled"
VOICE_ENDPOINT_UNSURE_MS=900       # no cue either way (the old fixed pause)
VOICE_ENDPOINT_INCOMPLETE_MS=1600  # "... for", "the", "um"
# STT_MODEL=whisper-large-v3-turbo   # /transcribe (browsers without speech recognition); uses GROQ_API_KEY
# MAX_AUDIO_MB=10

# ── Server-side speech (microphone audio and spoken answers over /ws/voice) ──
# none: the browser recognises and speaks (Web Speech API).
# local: on this server's CPU. Docker builds the models in and uses local by default; without
#        Docker: pip install -r backend/requirements-speech.txt && python scripts/download_models.py --speech
# STT_PROVIDER=local           # none | local | deepgram | whisper   (default: local in Docker, none otherwise)
# TTS_PROVIDER=local           # none | local | deepgram | openai | elevenlabs
# DEEPGRAM_API_KEY=            # STT_PROVIDER=deepgram (model: STT_MODEL, default nova-3) / TTS_PROVIDER=deepgram
# STT_BASE_URL=                # whisper: self-hosted OpenAI-compatible server (else the LLM provider's key)
# STT_PARTIAL_INTERVAL_MS=1500 # whisper: re-transcribe this often while the user talks (0 = only at pauses)
# TTS_VOICE=                   # local: speaker number · deepgram: aura-2-thalia-en · openai: alloy · elevenlabs: voice id
# TTS_MODEL=                   # openai: gpt-4o-mini-tts · elevenlabs: eleven_flash_v2_5
# TTS_BASE_URL=                # openai: a self-hosted OpenAI-compatible speech server
# TTS_API_KEY=
# ELEVENLABS_API_KEY=
# VAD_MODEL=                   # default: MODEL_CACHE_DIR/vad/silero_vad.onnx if present, else an energy detector

# ── Answers ────────────────────────────────────────────────────────────
CITATION_VERIFICATION=flag     # off | flag (mark unsupported sentences) | strict (also drop them, unspoken)

# ── Ingestion ──────────────────────────────────────────────────────────
CHUNK_STRATEGY=section      # section | fixed
CHUNK_MAX_TOKENS=256        # section chunker budget, counted with the embedding model's tokenizer
OCR_ENABLED=true            # OCR scanned PDF pages and PNG/JPG uploads (RapidOCR)
DEFAULT_CAMPAIGN_ID=default # campaign used when a request names none
SEED_SAMPLE_DATA=true       # index sample_data/ on first start

# ── Storage (local dev; Docker overrides these) ────────────────────────
# QDRANT_URL=               # empty → embedded Qdrant under ./data
# DATA_DIR=./data

# ── Access control ─────────────────────────────────────────────────
# When set, /upload and DELETE /documents/* need header X-API-Key: <value>.
# A CORS_ORIGINS=* wildcard is then ignored; list your UI origin explicitly if it is cross-origin.
API_KEY=
CORS_ORIGINS=*

# ── Observability ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_QUERY_TEXT=true         # false keeps user utterances out of logs
